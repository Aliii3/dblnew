# Contact form — set ONE of the following:

# Option A: Resend (https://resend.com)
# RESEND_API_KEY=re_xxxxxxxx
# CONTACT_TO_EMAIL=clients@dblshot.co
# CONTACT_FROM_EMAIL=DBLSHOT <noreply@yourdomain.com>

# Option B: Formspree (https://formspree.io)
# FORMSPREE_FORM_ID=your_form_id

# Note: the site's "chat" is a built-in search/intent router — no AI key needed.

# Testimonials dashboard (/testimonials/dashboard) — required to sign in
# TESTIMONIALS_ADMIN_PASSWORD=choose-a-strong-password

# Testimonial storage. Without this, submissions are written to data/testimonials.json,
# which is fine locally but does NOT persist on Vercel (read-only filesystem).
# Create a Blob store in the Vercel dashboard (Storage tab) and Vercel injects this
# variable into the project automatically — you only set it by hand for local testing.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxx
